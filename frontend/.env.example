# EmberRoute frontend environment variables
# Copy this file to .env.local and set your values.
# Never commit .env.local to version control.

# Backend API base URL
# In development with Vite proxy configured, use relative paths (leave empty).
# In production, set to the full backend URL.
VITE_API_BASE_URL=

# Map tile attribution overrides (optional)
VITE_CARTO_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png

# OpenFreeMap vector basemap style URL (optional override)
# Defaults to https://tiles.openfreemap.org/styles/dark
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
